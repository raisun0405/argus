# Argus environment variables
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local: it's git-ignored.
#
# The keys are read SERVER-SIDE by the Vercel Edge functions in api/. They are NOT
# bundled into the browser. Locally, `npm run dev` runs those functions in-process
# (see vite.config.ts) and reads the keys from .env.local.
#
# On Vercel: set these under Project Settings → Environment Variables.

# Required: Nebius Token Factory API key (https://tokenfactory.nebius.com → API keys).
# Answers and Investigate mode run on NVIDIA Nemotron through it.
NEBIUS_API_KEY=

# Optional: another Token Factory model (default nvidia/nemotron-3-super-120b-a12b)
# NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: NVIDIA API key for Co-fold (Boltz-2 on NVIDIA's hosted API,
# https://build.nvidia.com/mit/boltz2). Without it the Co-fold tool is hidden.
NVIDIA_NIM_KEY=

# Optional: co-fold predictions per day per server instance (default 300; each visitor
# also has a limit of their own, 60 a day)
# COFOLD_DAILY_LIMIT=300

# Optional: Tavily API key (https://app.tavily.com → API keys). Lets Investigate mode search
# published research (PubMed, journals, preprints). Without it that step is never planned.
TAVILY_API_KEY=

# Optional: error alerts by email. Errors in visitors' browsers are always written to the
# server log (api/report.ts); with these two set, a new kind of error is also emailed to you
# through Resend (https://resend.com → API Keys → create one with "Sending access"). Without a
# domain of your own there, Resend only delivers to the address you signed up with.
# RESEND_API_KEY=
# REPORTS_EMAIL=you@example.com

# Optional: saved links. A Cloudflare R2 bucket keeps shared co-folds, folded sequences and
# over-long answers behind short links (api/saved.ts): the account ID, and an R2 API token with
# Object Read & Write on that bucket alone. Without them, other views keep their plain links.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=argus-saved
